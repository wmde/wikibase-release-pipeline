#!/usr/bin/env bash

set -euo pipefail

BOOTSTRAP_LOG="${WBS_BOOTSTRAP_LOG:-/tmp/wikibase-suite-installer.log}"
WBS_TOOLS_IMAGE="${WBS_TOOLS_IMAGE:-wikibase/wbs-tools:1}"
WBS_REPO_URL="${WBS_REPO_URL:-https://github.com/wmde/wikibase-suite.git}"
WBS_DIR="${WBS_DIR:-$HOME/wikibase-suite}"
WBS_DOCKER_DIR="${WBS_DOCKER_DIR:-$WBS_DIR}"
WBS_DOCKER_REPO_URL="${WBS_DOCKER_REPO_URL:-$WBS_REPO_URL}"
WBS_REF="${WBS_REF:-}"
RUNTIME_ARGS=()
WEB_SELECTED=false

exec > >(tee -a "$BOOTSTRAP_LOG") 2>&1

while (( $# )); do
  case "$1" in
    --web)
      WEB_SELECTED=true
      RUNTIME_ARGS+=("$1")
      ;;
    --wbs-ref)
      [[ -n "${2:-}" ]] || { echo "wbs: --wbs-ref requires a value."; exit 1; }
      WBS_REF="$2"
      shift
      ;;
    --wbs-ref=*)
      WBS_REF="${1#*=}"
      ;;
    --installer-dev|--dev)
      echo "wbs: installer development requires an existing checkout."
      exit 1
      ;;
    --skip-clone|--skip-deps|--skip-launch|--reset|--cli)
      echo "wbs: unsupported install option: $1"
      exit 1
      ;;
    *)
      RUNTIME_ARGS+=("$1")
      ;;
  esac
  shift
done

echo
echo "Wikibase Suite"
echo

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -e "$SCRIPT_DIR/.git" && -d "$SCRIPT_DIR/scripts" ]]; then
  WBS_DIR="$SCRIPT_DIR"
else
  if ! command -v docker >/dev/null 2>&1; then
    echo "Installing Docker..."
    curl -fsSL https://get.docker.com | sh
  fi
  docker info >/dev/null
  docker compose version >/dev/null

  if [[ "${WBS_TOOLS_SKIP_PULL:-false}" != true ]]; then
    echo "Pulling $WBS_TOOLS_IMAGE..."
    docker pull "$WBS_TOOLS_IMAGE"
  fi

  target_parent="$(dirname "$WBS_DOCKER_DIR")"
  mkdir -p "$target_parent"
  prepare_args=(prepare --target "$WBS_DOCKER_DIR" --repository "$WBS_DOCKER_REPO_URL")
  repository_mount=()
  if [[ "$WBS_DOCKER_REPO_URL" == /* && ( -e "$WBS_DOCKER_REPO_URL" || -e "$WBS_REPO_URL" ) ]]; then
    repository_parent="$(dirname "$WBS_DOCKER_REPO_URL")"
    repository_mount=(-v "$repository_parent:$repository_parent:ro")
  fi
  if [[ -n "$WBS_REF" ]]; then
    prepare_args+=(--ref "$WBS_REF")
  fi
  docker run --rm \
    -v "$target_parent:$target_parent" \
    "${repository_mount[@]}" \
    "$WBS_TOOLS_IMAGE" \
    node /app/dist/wbs.js "${prepare_args[@]}"

  touch "$WBS_DIR/installation.log"
  {
    echo "Bootstrap log from $BOOTSTRAP_LOG"
    cat "$BOOTSTRAP_LOG"
  } >> "$WBS_DIR/installation.log"
  # Continue the same installation log after handing control to the checkout.
  export WBS_LOG_INITIALIZED=1
fi

if [[ "$WEB_SELECTED" != true ]]; then
  RUNTIME_ARGS=(--web "${RUNTIME_ARGS[@]}")
fi

export WBS_DIR WBS_TOOLS_IMAGE
exec "$WBS_DIR/wbs" install "${RUNTIME_ARGS[@]}"
