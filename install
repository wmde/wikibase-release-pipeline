#!/usr/bin/env bash
set -euo pipefail

# --- Parse bootstrap arguments ---

RUNTIME_ARGS=()
WEB_SELECTED=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --web)
      WEB_SELECTED=true
      RUNTIME_ARGS+=( "$1" )
      ;;
    --wbs-ref)
      if [[ -z "${2:-}" ]]; then
        echo "⚠️ --wbs-ref requires a branch or tag name."
        exit 1
      fi
      WBS_REF="$2"
      shift
      ;;
    --wbs-ref=*)
      WBS_REF="${1#*=}"
      if [[ -z "$WBS_REF" ]]; then
        echo "⚠️ --wbs-ref requires a branch or tag name."
        exit 1
      fi
      ;;
    --debug)
      RUNTIME_ARGS+=( "$1" )
      ;;
    --local)
      RUNTIME_ARGS+=( "$1" )
      ;;
    --from-source)
      RUNTIME_ARGS+=( "$1" )
      ;;
    --installer-dev)
      echo "⚠️ Installer development requires an existing checkout. Run ./development/wbs-dev installer-dev web there."
      exit 1
      ;;
    --build)
      echo "⚠️ --build has been renamed to --from-source."
      exit 1
      ;;
    --dev)
      echo "⚠️ Installer development requires an existing checkout. Run ./development/wbs-dev installer-dev web there."
      exit 1
      ;;
    --skip-clone|--skip-deps|--skip-launch|--reset|--cli)
      echo "⚠️ Unsupported install option: $1"
      exit 1
      ;;
    *)
      RUNTIME_ARGS+=( "$1" )
      ;;
  esac
  shift
done

# When this script is run from a Wikibase Suite checkout, use that checkout
# instead of cloning again.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_WBS_DIR="$SCRIPT_DIR"
if [[ -e "$LOCAL_WBS_DIR/.git" && -d "$LOCAL_WBS_DIR/scripts" ]]; then
  WBS_DIR="$LOCAL_WBS_DIR"
  SKIP_CLONE=true
fi

# --- Installer variables (including defaults) ---

WBS_REPO_URL="${WBS_REPO_URL:-https://github.com/wmde/wikibase-suite.git}"
WBS_REF="${WBS_REF:-}"
export WBS_DIR="${WBS_DIR:-$HOME/wikibase-suite}"
WBS_SKIP_DEPENDENCY_INSTALLS="${WBS_SKIP_DEPENDENCY_INSTALLS:-false}"

# --- Functions ---

display_path() {
  local path="$1"

  if [[ "$path" == "$HOME" ]]; then
    printf '~'
  elif [[ "$path" == "$HOME/"* ]]; then
    printf '~/%s' "${path#"$HOME/"}"
  else
    printf '%s' "$path"
  fi
}

suite_version() {
  if [[ ! -f "$WBS_DIR/package.json" ]]; then
    return
  fi

  sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$WBS_DIR/package.json" | head -n 1
}

checkout_status() {
  local version
  local ref_name="$WBS_REF"

  version="$(suite_version)"

  if [[ "$ref_name" == "main" ]]; then
    ref_name="main branch"
  fi

  if [[ -n "$version" ]]; then
    echo "✅ Checked out $ref_name (Wikibase Suite $version)"
  else
    echo "✅ Checked out $ref_name"
  fi
}

install_git() {
  if command -v git >/dev/null 2>&1; then
    echo "✅ Git installed"
    return
  fi

  if command -v apt-get >/dev/null 2>&1; then
    # Debian / Ubuntu
    apt-get update >/dev/null 2>&1 || true
    apt-get install -y git >/dev/null 2>&1
  elif command -v dnf >/dev/null 2>&1; then
    # Fedora / RHEL 8+ / Rocky / Alma
    dnf install -y git >/dev/null 2>&1
  elif command -v yum >/dev/null 2>&1; then
    # CentOS 7 / Amazon Linux 2 / older RHEL-family (yum-based)
    # - Legacy yum path; installs Git from the default repos.
    #   On older CentOS 7 this will be an older Git version, but usually fine.
    yum install -y git >/dev/null 2>&1
  else
    echo "⚠️ Unsupported package manager. Please install Git manually."
    exit 1
  fi

  echo "✅ Git installed"
}

latest_stable_wbs_ref() {
  git ls-remote --tags --refs "$WBS_REPO_URL" 'refs/tags/wbs@*' |
    awk '
      $2 ~ /^refs\/tags\/wbs@[0-9]+\.[0-9]+\.[0-9]+$/ {
        ref = $2
        sub(/^refs\/tags\//, "", ref)
        version = ref
        sub(/^wbs@/, "", version)
        split(version, part, ".")

        if (!found ||
            part[1] + 0 > major ||
            (part[1] + 0 == major && part[2] + 0 > minor) ||
            (part[1] + 0 == major && part[2] + 0 == minor && part[3] + 0 > patch)) {
          found = 1
          latest = ref
          major = part[1] + 0
          minor = part[2] + 0
          patch = part[3] + 0
        }
      }

      END {
        if (found) {
          print latest
        }
      }
    '
}

resolve_wbs_ref() {
  local latest_ref

  if [[ -n "$WBS_REF" ]]; then
    return
  fi

  echo "🔎 Finding the latest stable Wikibase Suite release..."
  if ! latest_ref="$(latest_stable_wbs_ref)"; then
    echo "⚠️ Could not query Wikibase Suite releases from $WBS_REPO_URL."
    exit 1
  fi

  if [[ -z "$latest_ref" ]]; then
    echo "⚠️ No stable Wikibase Suite release was found."
    echo "Specify a release or development branch with --wbs-ref REF."
    exit 1
  fi

  WBS_REF="$latest_ref"
  echo "✅ Latest stable release: $WBS_REF"
}

clone_repo() {
  local wbs_parent_dir
  local wbs_target_dir

  wbs_parent_dir="$(dirname "$WBS_DIR")"
  wbs_target_dir="$(basename "$WBS_DIR")"

  mkdir -p "$wbs_parent_dir"
  pushd "$wbs_parent_dir" >/dev/null || return 1

  if [ ! -d "$wbs_target_dir/.git" ]; then
    resolve_wbs_ref
    git clone --branch "$WBS_REF" --single-branch --depth 1 "$WBS_REPO_URL" "$wbs_target_dir" >/dev/null 2>&1
    echo "✅ Wikibase Suite cloned to $(display_path "$WBS_DIR")"
    checkout_status
  else
    echo "✅ Wikibase Suite already present at $(display_path "$WBS_DIR")"
  fi

  popd >/dev/null || return 1
}

# --- Execution ---

echo
echo "Wikibase Suite"
echo
if [[ "$WBS_SKIP_DEPENDENCY_INSTALLS" != true ]]; then
  echo "🔧 Installing dependencies..."
  echo
  install_git
fi

if [[ "${SKIP_CLONE:-false}" != true ]]; then
  clone_repo
fi

if [[ "$WEB_SELECTED" != true ]]; then
  RUNTIME_ARGS=( --web "${RUNTIME_ARGS[@]}" )
fi

exec "$WBS_DIR/wbs" install "${RUNTIME_ARGS[@]}"
