# ##############################################################################
# Wikibase Suite - initial configuration
#
# See README.md for installation instructions and details on these values.
#
# Most values in .env are initial setup values. After the first docker compose
# up, changing them requires resetting the instance. Values that can be changed
# after setup are identified below.
#
# WARNING: Do not add comments on the same line as env vars: in some
# environments they will be included in the var!
# ##############################################################################

# Public hostname configuration. These two variables must be set for the install to proceed.
# Examples:
# WIKIBASE_PUBLIC_HOST=yourdomain.example
# WDQS_PUBLIC_HOST=query.yourdomain.example

WIKIBASE_PUBLIC_HOST=
WDQS_PUBLIC_HOST=

# MediaWiki (Wikibase) user. These three variables must be set for the install to proceed.
# Examples:
# MW_ADMIN_NAME=admin
# MW_ADMIN_EMAIL=admin@wikibase.example
# MW_ADMIN_PASS=change-this-password

MW_ADMIN_NAME=
MW_ADMIN_EMAIL=
MW_ADMIN_PASS=

# Database configuration
# DB_NAME and DB_USER can keep their defaults. 
# DB_PASS must be set.

DB_PASS=
DB_NAME=my_wiki
DB_USER=sqluser

# The following values can be changed after initial setup.
METADATA_CALLBACK=true

# Wikimedia login (optional)
WIKIMEDIA_OAUTH_CONSUMER_TOKEN=
WIKIMEDIA_OAUTH_SECRET_TOKEN=

# QLever static-index experiment only. Set a strong, private value before
# exposing docker-compose.qlever.yml; it authorizes its internal RDF updater.
QLEVER_ACCESS_TOKEN=
