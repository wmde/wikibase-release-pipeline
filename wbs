#!/usr/bin/env bash

set -euo pipefail

WBS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WBS_DIR
export TOOLS_DIR="${TOOLS_DIR:-$WBS_DIR/tools}"
export SCRIPTS_DIR="${SCRIPTS_DIR:-$TOOLS_DIR/scripts}"
export ENV_FILE_PATH="${ENV_FILE_PATH:-$WBS_DIR/.env}"

exec bash "$SCRIPTS_DIR/wbs.sh" "$@"
