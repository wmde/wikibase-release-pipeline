#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# Local development overrides are optional, but Docker Compose requires the
# configured env file to exist.
[ -f "local.env" ] || touch local.env
# shellcheck disable=SC1091
source local.env

# Reuse an existing GitHub CLI login for update-commits API requests.
# If gh is unavailable or unauthenticated, the updater falls back to anonymous access.
if [[ " $* " == *" update-commits "* ]] &&
  [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]] &&
  command -v gh > /dev/null 2>&1; then
  if github_api_token="$(gh auth token 2> /dev/null)"; then
    export GITHUB_TOKEN="$github_api_token"
  fi
fi

run_cli() {
  exec pnpm exec tsx scripts/wbs-dev/cli.ts "$@"
}

# Commands already running in the build-tools container can execute directly.
if [[ -f /.dockerenv ]]; then
  run_cli "$@"
fi

# Host and CI execution use the same pinned build-tools image.
docker network create wbs-dev > /dev/null 2>&1 || true
./scripts/build-tools.sh

exec docker compose --progress quiet run --rm runner \
  -c 'pnpm exec tsx scripts/wbs-dev/cli.ts "$@"' \
  -- "$@"
